<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_Sequence" Id="{f1de8ec9-179b-4df8-9097-158ff83ac1af}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Sequence
(*
    Canonical command sequence: PLCopen-style interface over a state machine.
    Copy this shape for anything with steps or waiting.

    Contract: call this FB unconditionally every cycle. bExecute is edge-triggered.
    Every waiting state has a timeout and a path to Error. Error is resettable.

    WHY THE TIMER IS CALLED ABOVE THE CASE AND NOT INSIDE IT
    Every instance that carries state - the edge detector, the step timer - is
    called exactly once, unconditionally, before the state machine runs. The CASE
    chooses the timer's *inputs*; it never chooses whether the call happens.
    Calling a timer inside the branch that reads it is the shape
    references/cyclic-execution-rules.md Rule 5 prints as WRONG: it stops being
    serviced the moment you leave the state, and one instance shared between two
    steps carries its elapsed time from one into the next. Rule 2 puts the same
    thing positively - the input is the control, not the call site.

    ABOVE it specifically, because these two are the machine's *sensors*: the
    CASE reads fbExecTrig.Q and fbStepTimer.Q to decide a transition, so calling
    them below would make it decide on the previous scan's edge and the previous
    scan's timeout. A block this FB *commands* - a motion block, a device FB -
    goes the other side, below the CASE, called unconditionally with the inputs
    the CASE has just set, so a command decided this scan is issued this scan.

    WHY THE STEP CONDITIONS ARE INPUTS
    A step's done-condition is the one thing a test has to control: hardwire it
    and the timeout branch becomes unreachable, so the error path - the code most
    likely to be wrong and least likely to run on a good day - can never be
    exercised. Taking the conditions as inputs lets a test hold a step open and
    watch it fault. Wire them to the real signal at the call site (a sensor, an
    axis status, another FB's bDone), or read that signal directly in the CASE
    branch if you accept that you are giving up the test.
*)
VAR_INPUT
    bExecute    : BOOL;                 // rising edge starts the sequence
    bReset      : BOOL;                 // clears the error state
    bStep1Done  : BOOL;                 // step 1 has finished its work
    bStep2Done  : BOOL;                 // step 2 has finished its work
    tStepTimeout: TIME := T#10S;        // max time allowed in any one step
END_VAR
VAR_OUTPUT
    bBusy       : BOOL;                 // sequence is running
    bDone       : BOOL;                 // completed successfully (until next Execute edge)
    bError      : BOOL;
    nErrorID    : UDINT;                // 0 = no error; see GVL_Errors
END_VAR
VAR
    eState      : E_SeqState := E_SeqState.Idle;
    eStatePrev  : E_SeqState := E_SeqState.Idle;
    fbExecTrig  : R_TRIG;
    fbStepTimer : TON;
    bStepChanged: BOOL;                 // TRUE for the one scan a new state is entered
    bTimedStep  : BOOL;                 // TRUE while a state that has a timeout is active
END_VAR
VAR CONSTANT
    cErrStep1Timeout : UDINT := 16#8101;
    cErrStep2Timeout : UDINT := 16#8102;
    cErrInvalidState : UDINT := 16#8FFF;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Rule 2 / Rule 5: every instance that carries state is called exactly once,
// unconditionally, before the state machine runs. Nothing below decides whether
// a call happens - only what its inputs are.
fbExecTrig(CLK := bExecute);

bStepChanged := (eState <> eStatePrev);
eStatePrev   := eState;

bTimedStep := (eState = E_SeqState.Step1) OR (eState = E_SeqState.Step2);

// A TON re-arms when IN goes low, so holding IN low for the single scan on which
// the state changed gives every step a full, fresh timeout. That is what makes
// one timer instance safe to share between steps: the reset is structural, not
// something a future transition has to remember to do.
fbStepTimer(IN := bTimedStep AND NOT bStepChanged, PT := tStepTimeout);

// Reset is handled outside the state machine so it works from any state.
IF bReset AND eState = E_SeqState.Error THEN
    nErrorID := 0;
    eState   := E_SeqState.Idle;
END_IF

CASE eState OF

    E_SeqState.Idle:
        IF fbExecTrig.Q THEN
            bDone  := FALSE;
            bError := FALSE;
            eState := E_SeqState.Step1;
        END_IF

    E_SeqState.Step1:
        IF bStep1Done THEN                      // wire this input to the real step-1 signal
            eState := E_SeqState.Step2;
        ELSIF fbStepTimer.Q THEN
            M_Fail(errorID := cErrStep1Timeout);
        END_IF

    E_SeqState.Step2:
        IF bStep2Done THEN                      // wire this input to the real step-2 signal
            eState := E_SeqState.Done;
        ELSIF fbStepTimer.Q THEN
            M_Fail(errorID := cErrStep2Timeout);
        END_IF

    E_SeqState.Done:
        bDone  := TRUE;
        eState := E_SeqState.Idle;

    E_SeqState.Error:
        // Define the safe output state here - what must be switched off on failure.
        ;

ELSE
    // Rule: an unreachable state means memory corruption or a missed CASE label.
    M_Fail(errorID := cErrInvalidState);
END_CASE

bBusy  := (eState <> E_SeqState.Idle) AND (eState <> E_SeqState.Error);
bError := (eState = E_SeqState.Error);
]]></ST>
    </Implementation>
    <Method Name="M_Fail" Id="{4df4ca21-902d-4af4-8bb4-b5dc09e5bd1d}">
      <Declaration><![CDATA[METHOD PRIVATE M_Fail
VAR_INPUT
    errorID : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nErrorID := errorID;
eState   := E_SeqState.Error;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
