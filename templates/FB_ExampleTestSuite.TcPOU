<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_ExampleTestSuite" Id="{d2ee9ac7-e056-40e4-96dc-db159d31b9e6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ExampleTestSuite EXTENDS FB_TestSuite
(*
    TcUnit test suite skeleton. Requires the TcUnit library (www.tcunit.org)
    installed and referenced in the .plcproj.

    Run it from a PRG on a dedicated task:
        PROGRAM PRG_Tests
        VAR
            fbSuite : FB_ExampleTestSuite;
        END_VAR
        // body:
        TcUnit.RUN();

    WHY THE FIXTURES LIVE HERE AND NOT IN THE TEST METHOD
    A sequence needs several scans to complete, and its timers only advance as
    real time passes between scans. Two consequences shape every test below:

      1. Fixtures are declared in the SUITE, not in the method. A method's VAR
         is equivalent to VAR_TEMP - it is re-initialised on every call - so an
         FB instance declared there would reset each cycle and never progress.

      2. You cannot loop a sequence to completion inside one call. A FOR loop
         calling the FB ten times runs ten times in the SAME scan, so no time
         elapses and no TON ever elapses either. Drive it once per cycle and
         assert when it arrives.

    WHY EACH FIXTURE GETS ITS OWN STEP CONDITIONS
    The two tests need the sequence to behave differently, so each drives its
    instance with different inputs: fbSeq is told its steps are done and must
    reach Done; fbSeqTimeout never is, and must fault on its own step timeout.
    Two instances of one FB with the same inputs can only ever take the same
    path - which is how a timeout test ends up asserting against a sequence
    that completed.

    TcUnit calls the suite body every cycle until each test calls
    TEST_FINISHED(), which is what makes the across-scans pattern work.
*)
VAR
    // Fixtures: suite-level so they survive between cycles.
    fbSeq           : FB_Sequence;
    fbSeqTimeout    : FB_Sequence;
    fbWatchdog      : TON;
    fbTimeoutWd     : TON;
END_VAR
VAR CONSTANT
    // A test that never reaches its condition would otherwise hang the suite
    // silently. Fail it instead, and make the reason obvious.
    cTestWatchdog   : TIME := T#10S;
    // Short enough that the timeout test finishes quickly, and far enough
    // below cTestWatchdog that the watchdog firing means the timeout path is
    // genuinely dead rather than merely slow.
    cStepTimeout    : TIME := T#500MS;
    // Must equal FB_Sequence's cErrStep1Timeout. It is a VAR CONSTANT there,
    // so the test cannot read it - change one and you must change the other.
    cErrStep1Timeout: UDINT := 16#8101;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Every test method is called unconditionally, every cycle.
// TcUnit tracks which have finished.
TestSequenceReachesDone();
TestTimeoutRaisesError();]]></ST>
    </Implementation>
    <Method Name="TestSequenceReachesDone" Id="{d75ed693-6883-41ad-9249-cf729d80b6ba}">
      <Declaration><![CDATA[METHOD PRIVATE TestSequenceReachesDone]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestSequenceReachesDone');

// One call per cycle. The sequence advances a step at a time, exactly as it
// would on the machine. Both step conditions are held true, so this instance
// must walk through to Done without any timer elapsing.
fbSeq(bExecute := TRUE, bStep1Done := TRUE, bStep2Done := TRUE);

fbWatchdog(IN := TRUE, PT := cTestWatchdog);

IF fbSeq.bDone THEN
    AssertFalse(
        Condition := fbSeq.bError,
        Message   := 'Sequence reached Done but also reported an error');
    TEST_FINISHED();

ELSIF fbSeq.bError THEN
    AssertFalse(
        Condition := fbSeq.bError,
        Message   := 'Sequence reported an error before reaching Done');
    TEST_FINISHED();

ELSIF fbWatchdog.Q THEN
    AssertTrue(
        Condition := FALSE,
        Message   := 'Sequence did not reach Done within the test watchdog');
    TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestTimeoutRaisesError" Id="{308cffd6-e678-4698-a69e-004620893b74}">
      <Declaration><![CDATA[METHOD PRIVATE TestTimeoutRaisesError]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestTimeoutRaisesError');

// The timeout branch is the code most likely to be wrong and least likely to
// be exercised on a good day, so it gets a test of its own. bStep1Done is held
// false, so the sequence sits in step 1 until its own step timer elapses and
// must fault. Shortening tStepTimeout keeps the test quick without changing
// which path it takes.
fbSeqTimeout(bExecute     := TRUE,
             bStep1Done   := FALSE,
             bStep2Done   := FALSE,
             tStepTimeout := cStepTimeout);

fbTimeoutWd(IN := TRUE, PT := cTestWatchdog);

IF fbSeqTimeout.bError THEN
    AssertEquals_UDINT(
        Expected := cErrStep1Timeout,
        Actual   := fbSeqTimeout.nErrorID,
        Message  := 'Timeout raised the wrong error id');
    TEST_FINISHED();

ELSIF fbSeqTimeout.bDone THEN
    AssertTrue(
        Condition := FALSE,
        Message   := 'Sequence completed although the step condition never became true');
    TEST_FINISHED();

ELSIF fbTimeoutWd.Q THEN
    AssertTrue(
        Condition := FALSE,
        Message   := 'Sequence neither completed nor timed out - the timeout path is dead');
    TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
