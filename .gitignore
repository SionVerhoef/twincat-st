_Boot/
_CompileInfo/
_Libraries/
*.tpy
*.tclrs
*.suo
*.user
*.bak

.DS_Store

# Local issue-tracker and agent scaffolding, if the maintainer's tooling creates
# it here. It is private workflow state, not part of the skill, and an auto-
# generated AGENTS.md in particular carries instructions meant for one person's
# setup rather than for anyone installing this.
.beads/
.dolt/
*.db
.beads-credential-key
/AGENTS.md
