<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_StateNoError" Id="{3d92f4c7-18ab-4f60-b2e1-55c7a0d3e114}" SpecialFunc="None">
    <Declaration><![CDATA[// X7 needs its own file: the rule is satisfied by an error, fault, alarm or abort
// word appearing anywhere in the file's implementations, so it cannot share one
// with the other fixtures.
FUNCTION_BLOCK FB_StateNoError
VAR
    eState : E_Step;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eState OF                      // X7 - no fault state is reachable from here
    0: eState := 1;
    1: eState := 0;
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
