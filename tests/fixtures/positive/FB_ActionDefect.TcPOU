<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_ActionDefect" Id="{7a2e4b16-9c03-4d5e-8f21-0b6d3ca9e847}" SpecialFunc="None">
    <Declaration><![CDATA[// parse_xml skipped <Action> containers, so nothing in one was ever reviewed —
// and because the code was invisible, every variable it used came back as CP24
// unused. This fixture holds both halves: the defect inside the action must be
// reported against the action, and the declarations it uses must stay quiet.
FUNCTION_BLOCK FB_ActionDefect
VAR
    fActual : LREAL;
    fTarget : LREAL;
    bAtTarget : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Act_Compare();
]]></ST>
    </Implementation>
    <Action Name="Act_Compare" Id="{8b3f5c27-ad14-4e6f-9032-1c7e4db0f958}">
      <Implementation>
        <ST><![CDATA[bAtTarget := (fActual = fTarget);   // CP8 - inside an action, and still a defect
]]></ST>
      </Implementation>
    </Action>
  </POU>
</TcPlcObject>
