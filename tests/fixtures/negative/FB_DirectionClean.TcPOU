<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_DirectionClean" Id="{feafcdaa-36f1-4310-be72-f25b4347bda9}" SpecialFunc="None">
    <Declaration><![CDATA[// Shapes the direction and FOR-loop rules must leave alone.
FUNCTION_BLOCK FB_DirectionClean
VAR_INPUT
    bExecute : BOOL;
    nCount   : INT;
END_VAR
VAR_OUTPUT
    bDone : BOOL;
    nSum  : INT;
END_VAR
VAR
    fbInner : FB_Inner;
    i       : INT;
    aData   : ARRAY[0..9] OF INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// A call spread over lines: each named argument starts a line, but none is a
// write to the local that shares its name. '=>' binds an output, so bDone is set.
fbInner(bExecute := bExecute,
        nCount   := nCount,
        bDone    => bDone);
nSum := 0;
FOR i := 0 TO 9 DO
    nSum := nSum + aData[i];
END_FOR
i := 0;                         // a fresh value after the loop is fine
FOR i := 0 TO 9 DO              // and so is a new loop over the same variable
    aData[i] := 0;
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
